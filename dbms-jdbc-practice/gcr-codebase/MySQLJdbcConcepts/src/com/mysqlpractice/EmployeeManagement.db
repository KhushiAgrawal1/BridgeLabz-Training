CREATE DATABASE mysql_jdbc_practice;

USE mysql_jdbc_practice;

CREATE TABLE employee(
    empId INT PRIMARY KEY,
    name VARCHAR(100),
    salary DOUBLE
);

INSERT INTO employee VALUES
(101,"Khushi",100000),
(102,"Tanisha",12345345),
(103,"Virendra",57483902),
(104,"Vishal",65431),
(105,"Vikash",1234567890);

SELECT *FROM employee;
show databases;

