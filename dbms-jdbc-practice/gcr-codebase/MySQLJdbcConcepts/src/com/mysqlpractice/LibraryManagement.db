CREATE TABLE books(
    -> book_id INT PRIMARY KEY,
    -> title VARCHAR(100),
    -> author VARCHAR(50),
    -> category VARCHAR(50),
    -> total_copies INT,
    -> available_copies INT
    -> );

INSERT INTO books VALUES
    -> (1, "Java Basics", "James Goshling", "Programming", 5, 3),
    -> (2, "DBMS Concepts", "Korth", "Database", 4,2),
    -> (3, "Python Guide", "Guido", "Programming", 6,6);


SELECT * FROM books;

+---------+---------------+----------------+-------------+--------------+------------------+
| book_id | title         | author         | category    | total_copies | available_copies |
+---------+---------------+----------------+-------------+--------------+------------------+
|       1 | Java Basics   | James Goshling | Programming |            5 |                3 |
|       2 | DBMS Concepts | Korth          | Database    |            4 |                2 |
|       3 | Python Guide  | Guido          | Programming |            6 |                6 |
+---------+---------------+----------------+-------------+--------------+------------------+

CREATE TABLE students(
    -> student_id INT PRIMARY KEY,
    -> name VARCHAR(50)
    -> );

CREATE TABLE borrow_records(
    -> borrow_id INT PRIMARY KEY,
    -> student_id INT,
    -> book_id INT,
    -> borrow_date DATE,
    -> return_date DATE
    -> );

INSERT INTO students VALUES
    -> (1,"Khushi"),
    -> (2,"Naman");


INSERT INTO borrow_records VALUES
    -> (101, 1, 1, '2026-01-01', NULL),
    -> (102, 2,2, "2026-01-05", "2026-01-12");


SELECT * FROM students;

+------------+--------+
| student_id | name   |
+------------+--------+
|          1 | Khushi |
|          2 | Naman  |
+------------+--------+


SELECT * FROM borrow_records;

+-----------+------------+---------+-------------+-------------+
| borrow_id | student_id | book_id | borrow_date | return_date |
+-----------+------------+---------+-------------+-------------+
|       101 |          1 |       1 | 2026-01-01  | NULL        |
|       102 |          2 |       2 | 2026-01-05  | 2026-01-12  |
+-----------+------------+---------+-------------+-------------+

SELECT borrow_id, student_id, book_id, DATEDIFF(CURDATE(), borrow_date)-7 AS late_days, (DATEDIFF(CURDATE(), borrow_date)-7)*5 AS fine_amount
    -> FROM borrow_records
    -> WHERE return_date IS NULL && DATEDIFF(CURDATE(), borrow_date)>7;
    
+-----------+------------+---------+-----------+-------------+
| borrow_id | student_id | book_id | late_days | fine_amount |
+-----------+------------+---------+-----------+-------------+
|       101 |          1 |       1 |        32 |         160 |
+-----------+------------+---------+-----------+-------------+

SELECT *
    -> FROM books
    -> WHERE author = 'James Goshling'
    -> AND category = 'Programming';
    
+---------+-------------+----------------+-------------+--------------+------------------+
| book_id | title       | author         | category    | total_copies | available_copies |
+---------+-------------+----------------+-------------+--------------+------------------+
|       1 | Java Basics | James Goshling | Programming |            5 |                3 |
+---------+-------------+----------------+-------------+--------------+------------------+

SELECT *
    -> FROM books
    -> WHERE available_copies > 0;
    
+---------+---------------+----------------+-------------+--------------+------------------+
| book_id | title         | author         | category    | total_copies | available_copies |
+---------+---------------+----------------+-------------+--------------+------------------+
|       1 | Java Basics   | James Goshling | Programming |            5 |                3 |
|       2 | DBMS Concepts | Korth          | Database    |            4 |                2 |
|       3 | Python Guide  | Guido          | Programming |            6 |                6 |
+---------+---------------+----------------+-------------+--------------+------------------+


SELECT *
    -> FROM books
    -> WHERE title LIKE "%Java%";
    
